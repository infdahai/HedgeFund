//! Unified Opinion API Client
//!
//! This module provides a high-performance REST client for Opinion Trade API.
//! It uses rquest (Chrome TLS fingerprint impersonation) for protected endpoints
//! and reqwest for standard endpoints.

use reqwest::{Client, Response, Proxy};
use serde::{de::DeserializeOwned, Serialize};
use std::sync::Arc;
use std::time::Duration;
use tokio::sync::Mutex;

use crate::config::ApiConfig;
use crate::error::{Error, Result};
use super::models::{
    OpinionResponse, MarketListResult, ApiMarket, TokenOrderbook, LatestPrice, 
    OrderListResult, UserOrder, QuoteTokenInfo, QuoteTokenList, UserAuthInfo
};

#[derive(Clone)]
pub struct OpinionClient {
    client: Client,
    impersonate_client: rquest::Client,
    base_url: String,
    api_key: String,
    cached_exchange_address: Arc<Mutex<Option<String>>>,
    cached_proxy_address: Arc<Mutex<Option<String>>>,
}

impl OpinionClient {
    pub fn new(config: &ApiConfig) -> Result<Self> {
        let mut headers = reqwest::header::HeaderMap::new();
        headers.insert(
            reqwest::header::USER_AGENT,
            reqwest::header::HeaderValue::from_static("curl/8.7.1"),
        );
        headers.insert(
            reqwest::header::ACCEPT,
            reqwest::header::HeaderValue::from_static("application/json"),
        );

        let mut client_builder = Client::builder()
            .default_headers(headers)
            .timeout(config.timeout)
            .pool_max_idle_per_host(32)
            .pool_idle_timeout(Duration::from_secs(90))
            .use_rustls_tls();

        if let Ok(proxy_url) = std::env::var("HTTP_PROXY") {
            if let Ok(proxy) = Proxy::all(&proxy_url) {
                tracing::info!("Configuring HTTP proxy: {}", proxy_url);
                client_builder = client_builder.proxy(proxy);
            }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = Proxy::all(&proxy_url) {
                tracing::info!("Configuring HTTPS proxy: {}", proxy_url);
                client_builder = client_builder.proxy(proxy);
            }
        }

        let client = client_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build HTTP client: {}", e)))?;

        let mut impersonate_builder = rquest::Client::builder()
            .timeout(config.timeout);

        if let Ok(proxy_url) = std::env::var("HTTP_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rrequest proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rrequest HTTPS proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }

        let impersonate_client = impersonate_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build impersonate client: {}", e)))?;

        Ok(Self {
            client,
            impersonate_client,
            base_url: config.rest_base_url.trim_end_matches('/').to_string(),
            api_key: config.api_key.clone(),
            cached_exchange_address: Arc::new(Mutex::new(None)),
            cached_proxy_address: Arc::new(Mutex::new(None)),
        })
    }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = Proxy::all(&proxy_url) {
                tracing::info!("Configuring HTTPS proxy: {}", proxy_url);
                client_builder = client_builder.proxy(proxy);
            }
        }

        let client = client_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build HTTP client: {}", e)))?;

        let mut impersonate_builder = rquest::Client::builder()
            .timeout(config.timeout);

        if let Ok(proxy_url) = std::env::var("HTTP_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rquest proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rrequest HTTPS proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }

        let impersonate_client = impersonate_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build impersonate client: {}", e)))?;

        Ok(Self {
            client,
            impersonate_client,
            base_url: config.rest_base_url.trim_end_matches('/').to_string(),
            api_key: config.api_key.clone(),
            cached_exchange_address: Arc::new(Mutex::new(None)),
            cached_proxy_address: Arc::new(Mutex::new(None)),
        })
    }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = Proxy::all(&proxy_url) {
                tracing::info!("Configuring HTTPS proxy: {}", proxy_url);
                client_builder = client_builder.proxy(proxy);
            }
        }

        let client = client_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build HTTP client: {}", e)))?;

        // Build rrequest client with proxy support
        let mut impersonate_builder = rquest::Client::builder()
            .timeout(config.timeout);

        // Add proxy if configured
        if let Ok(proxy_url) = std::env::var("HTTP_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rquest proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }
        if let Ok(proxy_url) = std::env::var("HTTPS_PROXY") {
            if let Ok(proxy) = reqwest::Proxy::all(&proxy_url) {
                tracing::info!("Configuring rquest HTTPS proxy: {}", proxy_url);
                impersonate_builder = impersonate_builder.proxy(proxy);
            }
        }

        let impersonate_client = impersonate_builder
            .build()
            .map_err(|e| Error::ConfigError(format!("failed to build impersonate client: {}", e)))?;

        Ok(Self {
            client,
            impersonate_client,
            base_url: config.rest_base_url.trim_end_matches('/').to_string(),
            api_key: config.api_key.clone(),
            cached_exchange_address: Arc::new(Mutex::new(None)),
            cached_proxy_address: Arc::new(Mutex::new(None)),
        })
    }

    fn build_url(&self, endpoint: &str) -> String {
        format!("{}/{}", self.base_url, endpoint)
    }

    pub async fn init(&self, chain_id: u64, quote_token: &str) -> Result<()> {
        let exchange_address = self.get_exchange_address(chain_id, quote_token).await?;
        *self.cached_exchange_address.lock().await = Some(exchange_address);

        let proxy_address = self.get_proxy_address(chain_id).await?;
        *self.cached_proxy_address.lock().await = proxy_address;

        Ok(())
    }

    pub async fn get_cached_exchange_address(&self) -> Option<String> {
        self.cached_exchange_address.lock().await.clone()
    }

    pub async fn get_cached_proxy_address(&self) -> Option<String> {
        self.cached_proxy_address.lock().await.clone()
    }

    // --- Standard Methods (Reqwest) ---

    pub async fn get<T: DeserializeOwned>(&self, endpoint: &str) -> Result<T> {
        let url = self.build_url(endpoint);
        tracing::debug!("GET request to: {}", url);

        let response = self
            .client
            .get(&url)
            .header("apikey", &self.api_key)
            .send()
            .await
            .map_err(Error::HttpError)?;

        self.handle_response(response).await
    }

    pub async fn post<T: DeserializeOwned, B: Serialize>(
        &self,
        endpoint: &str,
        body: &B,
    ) -> Result<T> {
        let url = self.build_url(endpoint);
        tracing::debug!("POST request to: {}", url);

        let response = self
            .client
            .post(&url)
            .header("apikey", &self.api_key)
            .header(reqwest::header::CONTENT_TYPE, "application/json")
            .json(body)
            .send()
            .await
            .map_err(Error::HttpError)?;

        self.handle_response(response).await
    }

    pub async fn delete<T: DeserializeOwned>(&self, endpoint: &str) -> Result<T> {
        let url = self.build_url(endpoint);
        tracing::debug!("DELETE request to: {}", url);

        let response = self
            .client
            .delete(&url)
            .header("apikey", &self.api_key)
            .send()
            .await
            .map_err(Error::HttpError)?;

        self.handle_response(response).await
    }

    async fn handle_response<T: DeserializeOwned>(&self, response: Response) -> Result<T> {
        let status = response.status();

        if status.is_success() {
            response.json::<T>().await.map_err(|e| Error::ApiError {
                status: status.as_u16(),
                message: format!("failed to parse response: {}", e),
            })
        } else if status.as_u16() == 429 {
            let retry_after = response
                .headers()
                .get("retry-after")
                .and_then(|v| v.to_str().ok())
                .and_then(|v| v.parse::<u64>().ok())
                .unwrap_or(1000);

            Err(Error::RateLimitExceeded {
                retry_after_ms: retry_after,
            })
        } else {
            let message = response
                .text()
                .await
                .unwrap_or_else(|_| "unknown error".into());

            Err(Error::ApiError {
                status: status.as_u16(),
                message,
            })
        }
    }

    // --- Impersonate Methods (rquest with Chrome TLS fingerprint) ---

    async fn impersonate_get<T: DeserializeOwned>(&self, endpoint: &str) -> Result<T> {
        let url = self.build_url(endpoint);
        tracing::debug!("Impersonate GET: {}", url);

        for attempt in 1..=3 {
            let result = self.impersonate_client
                .get(&url)
                .header("apikey", &self.api_key)
                .header("Accept", "application/json")
                .send()
                .await;

            match result {
                Ok(response) => {
                    let status = response.status();
                    if status.is_success() {
                        let text = response.text().await.map_err(|e| Error::ApiError {
                            status: 500,
                            message: format!("failed to read response: {}", e),
                        })?;
                        return serde_json::from_str(&text).map_err(|e| Error::ApiError {
                            status: 500,
                            message: format!("failed to parse response: {} - body: {}", e, text),
                        });
                    } else {
                        let message = response.text().await.unwrap_or_else(|_| "unknown error".into());
                        return Err(Error::ApiError {
                            status: status.as_u16(),
                            message,
                        });
                    }
                }
                Err(e) => {
                    let err_str = e.to_string();
                    let is_transient = err_str.contains("connection") 
                        || err_str.contains("SSL") 
                        || err_str.contains("tls")
                        || err_str.contains("timeout");
                    
                    if is_transient && attempt < 3 {
                        tracing::warn!("Transient error on attempt {}, retrying: {}", attempt, err_str);
                        tokio::time::sleep(Duration::from_millis(500)).await;
                        continue;
                    }
                    return Err(Error::InternalError(format!("impersonate request failed: {}", e)));
                }
            }
        }

        Err(Error::InternalError("impersonate_get: max retries exceeded".into()))
    }

    // --- Higher Level API Methods ---

    pub async fn get_markets(&self) -> Result<Vec<ApiMarket>> {
        self.get_markets_with_params(None, None).await
    }

    pub async fn get_markets_with_params(&self, status: Option<&str>, limit: Option<u32>) -> Result<Vec<ApiMarket>> {
        let mut endpoint = "market".to_string();
        let mut params = vec![];
        if let Some(s) = status {
            params.push(format!("status={}", s));
        }
        if let Some(l) = limit {
            params.push(format!("limit={}", l));
        }
        if !params.is_empty() {
            endpoint = format!("{}?{}", endpoint, params.join("&"));
        }
        let response: OpinionResponse<MarketListResult> = self.get(&endpoint).await?;
        response.into_result().map(|r| r.list)
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn get_orderbook(&self, token_id: &str) -> Result<TokenOrderbook> {
        let endpoint = format!("token/orderbook?token_id={}", token_id);
        let response: OpinionResponse<TokenOrderbook> = self.get(&endpoint).await?;
        response.into_result()
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn get_latest_price(&self, token_id: &str) -> Result<LatestPrice> {
        let endpoint = format!("token/latest-price?token_id={}", token_id);
        let response: OpinionResponse<LatestPrice> = self.get(&endpoint).await?;
        response.into_result()
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn get_orders(&self, market_id: Option<i64>, limit: Option<u32>) -> Result<Vec<UserOrder>> {
        let mut endpoint = "order".to_string();
        let mut params = vec![];
        if let Some(id) = market_id {
            params.push(format!("marketId={}", id));
        }
        if let Some(l) = limit {
            params.push(format!("limit={}", l));
        }
        if !params.is_empty() {
            endpoint = format!("{}?{}", endpoint, params.join("&"));
        }
        
        let response: OpinionResponse<OrderListResult> = self.get(&endpoint).await?;
        response.into_result().map(|r| r.list)
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn cancel_order(&self, order_id: &str) -> Result<serde_json::Value> {
        let body = serde_json::json!({"orderId": order_id});
        let response: OpinionResponse<serde_json::Value> = self.post("order/cancel", &body).await?;
        response.into_result()
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    // --- Init/Auth Methods (using impersonate client for TLS bypass) ---

    pub async fn get_quote_tokens(&self, chain_id: u64) -> Result<Vec<QuoteTokenInfo>> {
        let endpoint = format!("quoteToken?chainId={}", chain_id);
        let response: OpinionResponse<QuoteTokenList> = self.impersonate_get(&endpoint).await?;
        response.into_result().map(|r| r.list)
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn get_exchange_address(&self, chain_id: u64, quote_token: &str) -> Result<String> {
        if let Some(cached) = self.cached_exchange_address.lock().await.as_ref() {
            return Ok(cached.clone());
        }

        let tokens = self.get_quote_tokens(chain_id).await?;

        tokens
            .iter()
            .find(|t| t.quote_token_address.eq_ignore_ascii_case(quote_token))
            .map(|t| t.ctf_exchange_address.clone())
            .ok_or_else(|| Error::ApiError {
                status: 404,
                message: format!("Exchange address not found for quote token: {}", quote_token),
            })
    }

    pub async fn get_user_auth(&self) -> Result<UserAuthInfo> {
        let response: OpinionResponse<UserAuthInfo> = self.impersonate_get("user/auth").await?;
        response.into_result()
            .map_err(|e| Error::ApiError { status: 500, message: e })
    }

    pub async fn get_proxy_address(&self, chain_id: u64) -> Result<Option<String>> {
        if let Some(cached) = self.cached_proxy_address.lock().await.as_ref() {
            return Ok(Some(cached.clone()));
        }

        let auth = self.get_user_auth().await?;
        Ok(auth.wallet_users.get(&chain_id.to_string()).cloned())
    }
}
