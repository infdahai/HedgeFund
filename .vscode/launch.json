{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Main",
            "cargo": {
                "args": ["build", "--bin=opinion-hft"]
            },
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "OPINION_ENV": "local",
                "OPINION_PROXY_URL": "http://127.0.0.1:7890"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Tests",
            "cargo": {
                "args": ["test", "--no-run", "--lib"]
            },
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1",
                "OPINION_ENV": "local",
                "OPINION_PROXY_URL": "http://127.0.0.1:7890"
            }
        }
    ]
}
