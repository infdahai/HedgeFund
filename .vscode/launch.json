{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Main",
            "cargo": {
                "args": [
                    "build",
                    "--package=opinion-hft",
                    "--bin=opinion-hft"
                ],
                "filter": {
                    "name": "opinion-hft",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug"
            },
            "preLaunchTask": "cargo: build opinion-hft"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Unit Tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=opinion-hft",
                    "--lib"
                ],
                "filter": {
                    "name": "opinion-hft",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug All Tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=opinion-hft"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Integration Tests (live)",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=opinion-hft",
                    "--test=live_integration"
                ]
            },
            "args": [
                "--test-threads=1"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Specific Test",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=opinion-hft"
                ]
            },
            "args": [
                "${input:testName}",
                "--exact",
                "--nocapture"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Signer Benchmark",
            "cargo": {
                "args": [
                    "bench",
                    "--no-run",
                    "--package=opinion-hft",
                    "--bench=signer_bench"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "info",
                "RUST_BACKTRACE": "1"
            }
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "testName",
            "description": "Enter the full test name to debug (e.g., tests::test_order_lifecycle)",
            "default": ""
        }
    ]
}
