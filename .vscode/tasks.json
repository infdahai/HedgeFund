{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: build opinion-hft",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--package=opinion-hft",
                "--bin=opinion-hft"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: check",
            "type": "shell",
            "command": "cargo",
            "args": [
                "check"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: clippy",
            "type": "shell",
            "command": "cargo",
            "args": [
                "clippy",
                "--",
                "-D",
                "warnings"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: test (unit)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--lib"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ],
            "dependsOn": [
                "cargo: check"
            ]
        },
        {
            "label": "cargo: test (all)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ],
            "dependsOn": [
                "cargo: check"
            ]
        },
        {
            "label": "cargo: test (integration)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--tests"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ],
            "dependsOn": [
                "cargo: check"
            ]
        },
        {
            "label": "cargo: run",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "dependsOn": [
                "cargo: check"
            ]
        },
        {
            "label": "cargo: bench",
            "type": "shell",
            "command": "cargo",
            "args": [
                "bench"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ],
            "dependsOn": [
                "cargo: check"
            ]
        },
        {
            "label": "cargo: clean",
            "type": "shell",
            "command": "cargo",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "cargo: doc",
            "type": "shell",
            "command": "cargo",
            "args": [
                "doc",
                "--no-deps",
                "--open"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
