#!/bin/bash
# Pre-push hook: Prevent direct pushes to main branch
# This is the local equivalent of GitHub branch protection (requires Pro for private repos)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

while read local_ref local_sha remote_ref remote_sha
do
    # Only check pushes to main branch
    if [[ "$local_ref" == "refs/heads/main" ]]; then
        echo -e "${RED}🚫 DIRECT PUSH TO MAIN BRANCH DENIED${NC}"
        echo ""
        echo -e "${YELLOW}To protect the main branch, all changes must go through a Pull Request.${NC}"
        echo ""
        echo "Solution:"
        echo "  1. Create a feature branch:"
        echo "     git checkout -b feature/your-task-name"
        echo ""
        echo "  2. Push your changes:"
        echo "     git push -u origin feature/your-task-name"
        echo ""
        echo "  3. Create a Pull Request:"
        echo "     gh pr create --base main --fill"
        echo ""
        echo -e "${GREEN}CI will run automatically on the PR.${NC}"
        echo ""
        exit 1
    fi
done
