[Unit]
Description=Opinion HFT Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opinion
Group=opinion
WorkingDirectory=/opt/opinion-hft
EnvironmentFile=/etc/opinion-hft/opinion-hft.env
ExecStart=/opt/opinion-hft/bin/opinion-hft
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
